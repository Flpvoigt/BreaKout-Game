{
  "rules": {
    "leaderboard": {
      ".read": true,
      "$player_id": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'score'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
